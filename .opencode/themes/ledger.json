{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ink0": "#0f1115",
    "ink1": "#15181e",
    "ink2": "#1c2027",
    "ink3": "#242933",
    "ink4": "#2e3540",
    "fog": "#8b929e",
    "fogDim": "#737a86",
    "chalk": "#e6e2da",
    "amber": "#e3a72f",
    "amberSoft": "#f0c56a",
    "sage": "#8fbf7f",
    "rose": "#e06c6c",
    "clay": "#d98e5a",
    "sky": "#7aa5d0",
    "mossBg": "#1d271d",
    "rustBg": "#2a1d1d"
  },
  "theme": {
    "primary": { "dark": "amber", "light": "amber" },
    "secondary": { "dark": "sky", "light": "sky" },
    "accent": { "dark": "amberSoft", "light": "amberSoft" },
    "error": { "dark": "rose", "light": "rose" },
    "warning": { "dark": "clay", "light": "clay" },
    "success": { "dark": "sage", "light": "sage" },
    "info": { "dark": "sky", "light": "sky" },
    "text": { "dark": "chalk", "light": "chalk" },
    "textMuted": { "dark": "fog", "light": "fog" },
    "background": { "dark": "ink0", "light": "ink0" },
    "backgroundPanel": { "dark": "ink1", "light": "ink1" },
    "backgroundElement": { "dark": "ink2", "light": "ink2" },
    "border": { "dark": "ink4", "light": "ink4" },
    "borderActive": { "dark": "amber", "light": "amber" },
    "borderSubtle": { "dark": "ink3", "light": "ink3" },
    "diffAdded": { "dark": "sage", "light": "sage" },
    "diffRemoved": { "dark": "rose", "light": "rose" },
    "diffContext": { "dark": "fog", "light": "fog" },
    "diffHunkHeader": { "dark": "fog", "light": "fog" },
    "diffHighlightAdded": { "dark": "sage", "light": "sage" },
    "diffHighlightRemoved": { "dark": "rose", "light": "rose" },
    "diffAddedBg": { "dark": "mossBg", "light": "mossBg" },
    "diffRemovedBg": { "dark": "rustBg", "light": "rustBg" },
    "diffContextBg": { "dark": "ink1", "light": "ink1" },
    "diffLineNumber": { "dark": "fog", "light": "fog" },
    "diffAddedLineNumberBg": { "dark": "mossBg", "light": "mossBg" },
    "diffRemovedLineNumberBg": { "dark": "rustBg", "light": "rustBg" },
    "markdownText": { "dark": "chalk", "light": "chalk" },
    "markdownHeading": { "dark": "amber", "light": "amber" },
    "markdownLink": { "dark": "sky", "light": "sky" },
    "markdownLinkText": { "dark": "sky", "light": "sky" },
    "markdownCode": { "dark": "sage", "light": "sage" },
    "markdownBlockQuote": { "dark": "fog", "light": "fog" },
    "markdownEmph": { "dark": "clay", "light": "clay" },
    "markdownStrong": { "dark": "amberSoft", "light": "amberSoft" },
    "markdownHorizontalRule": { "dark": "ink4", "light": "ink4" },
    "markdownListItem": { "dark": "sky", "light": "sky" },
    "markdownListEnumeration": { "dark": "amber", "light": "amber" },
    "markdownImage": { "dark": "sky", "light": "sky" },
    "markdownImageText": { "dark": "fog", "light": "fog" },
    "markdownCodeBlock": { "dark": "chalk", "light": "chalk" },
    "syntaxComment": { "dark": "fogDim", "light": "fogDim" },
    "syntaxKeyword": { "dark": "amber", "light": "amber" },
    "syntaxFunction": { "dark": "sky", "light": "sky" },
    "syntaxVariable": { "dark": "chalk", "light": "chalk" },
    "syntaxString": { "dark": "sage", "light": "sage" },
    "syntaxNumber": { "dark": "clay", "light": "clay" },
    "syntaxType": { "dark": "amberSoft", "light": "amberSoft" },
    "syntaxOperator": { "dark": "fog", "light": "fog" },
    "syntaxPunctuation": { "dark": "fog", "light": "fog" }
  }
}
