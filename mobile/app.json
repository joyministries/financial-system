{
  "expo": {
    "name": "Lambton School",
    "slug": "school-finance-mobile",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.lambtonchristian.school",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to scan documents.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to upload documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#132043"
      },
      "package": "co.za.lambtonchristian.school",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C08A34"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "cfcea5c9-7f38-43a2-80e1-529b20748c44"
      }
    },
    "owner": "jministries"
  }
}
