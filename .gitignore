# ── Environment / secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
env.txt
*-env.txt

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Type checking / linting caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Alembic ────────────────────────────────────────────────────────
# Local migration artifacts (not the versions themselves)
alembic/versions/*.pyc

# ── Celery ─────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Uploaded files (user documents — never commit) ────────────────
uploads/

# ── Credentials / temp data ──────────────────────────────────────
temp_credentials.txt
scripts/temp_credentials.txt

# ── Frontend ───────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Vercel
frontend/.vercel/

# ── Build artifacts ────────────────────────────────────────────────
*.tsbuildinfo

# ── OS / editor junk ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ── Docker ─────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Local dev notes (not part of the product) ─────────────────────
PROGRESS.txt
financial_see.txt

# ── Markdown docs (only root README is tracked) ───────────────────
*.md
!/README.md
