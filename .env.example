DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_finance
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
JWT_SECRET_KEY=your-production-secret-key-here
SUPERADMIN_EMAIL=admin@school.com
SUPERADMIN_PASSWORD=changeme

# PayFast payment gateway (https://developers.payfast.co.za/docs)
# Get merchant_id / merchant_key from your PayFast dashboard (sandbox or live).
# Leave PASSPHRASE empty unless you set a passphrase on the dashboard.
# PAYFAST_MODE=sandbox      # sandbox | live
# PAYFAST_MERCHANT_ID=10000000
# PAYFAST_MERCHANT_KEY=your-merchant-key
# PAYFAST_PASSPHRASE=
# PAYFAST_BASE_URL=http://localhost:8000   # used to build return/cancel/notify URLs
# PAYFAST_RETURN_URL=
# PAYFAST_CANCEL_URL=
# PAYFAST_NOTIFY_URL=
